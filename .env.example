# Copy to .env (never commit .env). Server-side secrets never ship in the phone or web app.
SUPABASE_URL=
SUPABASE_ANON_KEY=            # safe for clients; protected by row-level security
SUPABASE_SERVICE_ROLE_KEY=    # SERVER ONLY
MAPBOX_PUBLIC_TOKEN=          # URL-restricted public token for map display
MAPBOX_SECRET_TOKEN=          # SERVER ONLY (offline packs, uploads)
AISSTREAM_API_KEY=            # SERVER ONLY (ingest worker)
OPEN_METEO_API_KEY=           # SERVER ONLY
REVENUECAT_SECRET_KEY=        # SERVER ONLY
STRIPE_SECRET_KEY=            # SERVER ONLY
SENTRY_DSN=
